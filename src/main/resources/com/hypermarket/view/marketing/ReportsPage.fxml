<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15"
    style="-fx-padding: 20;"
    stylesheets="@../../css/MarketingDashboard.css"
    xmlns="http://javafx.com/javafx/25"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.hypermarket.modules.marketing.ReportsPageController">

    <VBox spacing="10">
        <TextArea fx:id="inputReportArea"
            promptText="Write your daily marketing report here..."
            wrapText="true"
            styleClass="report-input-area" />

        <AnchorPane>
            <Button fx:id="generateReportBtn"
                styleClass="confirm-btn"
                text="Submit Report"
                AnchorPane.rightAnchor="0.0" />
        </AnchorPane>
    </VBox>

    <ScrollPane fitToWidth="true"
        fitToHeight="true"
        styleClass="transparent-scroll-pane"
        VBox.vgrow="ALWAYS">

        <VBox fx:id="reportsContainer" spacing="12" style="-fx-padding: 5;" />

    </ScrollPane>

</VBox>