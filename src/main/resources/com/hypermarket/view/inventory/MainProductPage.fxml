<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
   prefHeight="400.0" prefWidth="600.0" stylesheets="@MainProductPage.css"
   xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
   fx:controller="com.hypermarket.ProductDetailsController">
   <children>
      <HBox layoutX="-1.0" layoutY="1.0" prefHeight="400.0" prefWidth="600.0">
         <children>
            <VBox prefHeight="400.0" prefWidth="106.0">
               <children>
                  <ImageView fx:id="productImage" fitHeight="400.0" fitWidth="588.0"
                     pickOnBounds="true" preserveRatio="true" styleClass="product-image">
                     <image>
                        <Image
                           url="@../../../../../../../../../../front-view-natural-cream-concept.jpg" />
                     </image>
                  </ImageView>
               </children>
            </VBox>
            <VBox prefHeight="384.0" prefWidth="330.0">
               <children>
                  <Label fx:id="productName" prefHeight="66.0" prefWidth="330.0"
                     styleClass="product-name" text="THE PRODUCT NAME">
                     <padding>
                        <Insets left="10.0" />
                     </padding>
                  </Label>
                  <TextField fx:id="decription" alignment="TOP_LEFT" prefHeight="78.0"
                     prefWidth="330.0" />
                  <VBox prefHeight="254.0" prefWidth="330.0">
                     <children>
                        <Label fx:id="categoryLabel" prefHeight="42.0" prefWidth="394.0"
                           styleClass="product-info" text="Category : XXXXXX">
                           <padding>
                              <Insets left="20.0" />
                           </padding>
                        </Label>
                        <Separator nodeOrientation="LEFT_TO_RIGHT" prefWidth="200.0"
                           styleClass="info-separator">
                           <VBox.margin>
                              <Insets left="20.0" />
                           </VBox.margin>
                        </Separator>
                        <Label fx:id="productID" prefHeight="42.0" prefWidth="394.0"
                           styleClass="product-info" text="Product ID : XXXXXX">
                           <padding>
                              <Insets left="20.0" />
                           </padding>
                        </Label>
                        <Separator nodeOrientation="LEFT_TO_RIGHT" prefWidth="200.0"
                           styleClass="info-separator">
                           <VBox.margin>
                              <Insets left="20.0" />
                           </VBox.margin>
                        </Separator>
                        <HBox prefHeight="42.0" prefWidth="330.0">
                           <children>
                              <Label fx:id="priceLable" prefHeight="42.0" prefWidth="156.0"
                                 styleClass="product-info" text="Price : XXXXXX">
                                 <padding>
                                    <Insets left="20.0" />
                                 </padding>
                              </Label>
                              <Label fx:id="offerLabel" prefHeight="38.0" prefWidth="174.0"
                                 styleClass="product-info" text="Offer : XXXXXX">
                                 <padding>
                                    <Insets left="20.0" />
                                 </padding>
                              </Label>
                           </children>
                        </HBox>
                        <Separator nodeOrientation="LEFT_TO_RIGHT" prefWidth="200.0"
                           styleClass="info-separator">
                           <VBox.margin>
                              <Insets left="20.0" />
                           </VBox.margin>
                        </Separator>
                        <Label fx:id="quantityLabel" prefHeight="42.0" prefWidth="394.0"
                           styleClass="product-info" text="Quantity : XXXXXX">
                           <padding>
                              <Insets left="20.0" />
                           </padding>
                        </Label>
                        <Separator nodeOrientation="LEFT_TO_RIGHT" prefHeight="11.0"
                           prefWidth="235.0" styleClass="info-separator">
                           <VBox.margin>
                              <Insets left="20.0" />
                           </VBox.margin>
                        </Separator>
                        <Label fx:id="sizeLabel" prefHeight="42.0" prefWidth="394.0"
                           styleClass="product-info" text="Size : XXXXXX">
                           <padding>
                              <Insets left="20.0" />
                           </padding>
                        </Label>
                        <Separator nodeOrientation="LEFT_TO_RIGHT" prefWidth="200.0"
                           styleClass="info-separator">
                           <VBox.margin>
                              <Insets left="20.0" />
                           </VBox.margin>
                        </Separator>
                        <Label fx:id="durationLabel" prefHeight="42.0" prefWidth="330.0"
                           styleClass="product-info" text="Duration : XXXXXX">
                           <padding>
                              <Insets left="20.0" />
                           </padding>
                        </Label>
                        <Separator nodeOrientation="LEFT_TO_RIGHT" prefWidth="200.0"
                           styleClass="info-separator">
                           <VBox.margin>
                              <Insets left="20.0" />
                           </VBox.margin>
                        </Separator>
                     </children>
                  </VBox>
               </children>
            </VBox>
         </children>
      </HBox>
   </children>
</AnchorPane>