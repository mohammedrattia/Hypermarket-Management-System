<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="mainContainer" alignment="TOP_CENTER" prefHeight="640.0" prefWidth="1030.0"
    styleClass="main-container" xmlns="http://javafx.com/javafx/25"
    xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.hypermarket.modules.inventory.ListReturns">
    <children>
        <HBox alignment="CENTER_LEFT" spacing="15.0">
            <children>
                <Button text="Delete Damaged Order" onAction="#handleDeleteDamaged" styleClass="remove-btn"/>
                <Region HBox.hgrow="ALWAYS" />
                <Button text="Re-add to Stock" onAction="#handleReAddToStock" styleClass="new-order-btn"/>
            </children>
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
        </HBox>
        <AnchorPane fx:id="listArea" maxHeight="1.7976931348623157E308" prefHeight="200.0"
            prefWidth="200.0" styleClass="list-area" VBox.vgrow="ALWAYS" />
    </children>
    <stylesheets>
        <URL value="@../../css/ListOrders.css" />
    </stylesheets>

</VBox>