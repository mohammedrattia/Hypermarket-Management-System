<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
  prefHeight="720.0" prefWidth="1280.0" styleClass="main-scene" stylesheets="@../../css/Login.css"
  xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
  fx:controller="com.hypermarket.modules.user.LoginController">
  <children>
    <StackPane prefHeight="720.0" prefWidth="1280.0" AnchorPane.bottomAnchor="0.0"
      AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
      <children>
        <VBox alignment="CENTER_LEFT" maxHeight="-Infinity" maxWidth="-Infinity"
          prefWidth="350.0" spacing="15.0" styleClass="form-container">
          <children>
            <Label alignment="CENTER" maxWidth="1.7976931348623157E308"
              styleClass="login-title" text="Login">
              <VBox.margin>
                <Insets bottom="10.0" />
              </VBox.margin>
            </Label>
            <HBox prefHeight="2.0" prefWidth="270.0" styleClass="test-credentials-box">
              <children>
                <Button fx:id="testAdminButton" mnemonicParsing="false"
                  styleClass="test-credentials-btn" text="Admin" />
                <Button fx:id="testInventoryButton" mnemonicParsing="false"
                  styleClass="test-credentials-btn" text="Inventory" />
                <Button fx:id="testMarketingButton" mnemonicParsing="false"
                  styleClass="test-credentials-btn" text="Marketing" />
                <Button fx:id="testSalesButton" mnemonicParsing="false"
                  styleClass="test-credentials-btn" text="Sales" />
              </children>
            </HBox>
            <Label styleClass="field-label" text="Email:" />
            <TextField fx:id="emailField" promptText="Enter your email" />
            <Label styleClass="field-label" text="Password:" />

            <StackPane alignment="CENTER_RIGHT">
              <children>
                <TextField fx:id="passTextField" managed="false" promptText="Enter your password"
                  styleClass="password-input" visible="false" />

                <PasswordField fx:id="passField" promptText="Enter your password"
                  styleClass="password-input" />

                <FontIcon fx:id="passToggleIcon" iconLiteral="fas-eye" iconSize="18"
                  onMouseClicked="#togglePasswordVisibility" styleClass="eye-icon">
                  <StackPane.margin>
                    <Insets right="15.0" />
                  </StackPane.margin>
                </FontIcon>
              </children>
            </StackPane>

            <StackPane>
              <children>
                <Button fx:id="loginButton" mnemonicParsing="false"
                  onAction="#onLoginButtonClick" text="Login" />
              </children>
              <VBox.margin>
                <Insets top="20.0" />
              </VBox.margin>
            </StackPane>
          </children>
          <padding>
            <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
          </padding>
        </VBox>
      </children>
    </StackPane>
  </children>
</AnchorPane>