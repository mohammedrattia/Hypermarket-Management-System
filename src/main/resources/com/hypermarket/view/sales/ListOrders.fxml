<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="mainContainer" alignment="TOP_CENTER" prefHeight="640.0" prefWidth="1030.0" styleClass="main-container" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.hypermarket.modules.sales.ListOrders">
  <children>
    <HBox fx:id="optionsBar" alignment="CENTER_RIGHT" prefHeight="80.0" prefWidth="200.0" styleClass="options-bar">
      <children>
        <Button fx:id="newOrderButton" mnemonicParsing="false" styleClass="new-order-btn" text="New Order">
        </Button>
        <Region prefHeight="200.0" prefWidth="200.0" HBox.hgrow="ALWAYS" />
        <Button fx:id="viewReceiptButton" mnemonicParsing="false" styleClass="receipt-btn" text="View Receipt">
        </Button>
        <Button fx:id="returnOrderButton" mnemonicParsing="false" styleClass="remove-btn" text="Return Order">
        </Button>
      </children>
    </HBox>
      <AnchorPane fx:id="listArea" maxHeight="1.7976931348623157E308" prefHeight="200.0" prefWidth="200.0" styleClass="list-area" VBox.vgrow="ALWAYS" />
  </children>
  <stylesheets>
    <URL value="@../../css/ListOrders.css" />
    <URL value="@../../css/SalesThemes.css" />
  </stylesheets>

</VBox>
