<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox fx:id="returnOrderRoot" prefHeight="700.0" prefWidth="800.0" styleClass="sidebar-panel"
    xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.hypermarket.modules.sales.MakeReturn">

    <stylesheets>
        <URL value="@../../css/MakeOrder.css" />
        <URL value="@../../css/ReturnOrder.css" />
    </stylesheets>

    <children>
        <HBox fx:id="topBarButtons" alignment="CENTER_LEFT" prefHeight="60.0" spacing="10.0"
            styleClass="topbar">
            <children>
                <Label styleClass="header-title" text="Return Items" />
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="returnAllButton" mnemonicParsing="false"
                    styleClass="action-btn, green-outline-btn" text="Return All Max">
                    <graphic>
                        <FontIcon iconColor="#10b981" iconLiteral="fas-angle-double-up" />
                    </graphic>
                </Button>
                <Button fx:id="clearSelectionButton" mnemonicParsing="false"
                    styleClass="action-btn, grey-btn" text="Reset">
                    <graphic>
                        <FontIcon iconColor="white" iconLiteral="fas-undo" />
                    </graphic>
                </Button>
            </children>
            <padding>
                <Insets left="20.0" right="20.0" />
            </padding>
        </HBox>

        <ListView fx:id="returnItemsList" styleClass="items-list-section" VBox.vgrow="ALWAYS" />

        <Separator prefWidth="200.0" />

        <HBox alignment="TOP_CENTER" prefHeight="200.0" spacing="20.0" styleClass="totals-section">
            <padding>
                <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
            </padding>

            <children>
                <VBox maxWidth="320.0" prefHeight="228.0" prefWidth="280.0" spacing="8.0">
                    <children>
                        <Label
                            style="-fx-font-weight:bold; -fx-text-fill:#94a3b8; -fx-font-size: 11px;"
                            text="ORIGINAL ORDER INFO" />
                        <HBox alignment="CENTER_LEFT" prefHeight="30.0" prefWidth="200.0"
                            styleClass="order-detail-box">
                            <children>
                                <FontIcon iconLiteral="fas-barcode" iconSize="14"
                                    styleClass="detail-icon" wrappingWidth="12.67498779296875" />
                                <Label styleClass="order-detail-label" text="Order ID :" />
                                <Label fx:id="orderDetailID" styleClass="order-detail-value"
                                    text="1002" />
                            </children>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" prefHeight="30.0" prefWidth="200.0"
                            styleClass="order-detail-box">
                            <children>
                                <FontIcon iconLiteral="fas-dollar-sign" iconSize="14"
                                    styleClass="detail-icon" wrappingWidth="12.67498779296875" />
                                <Label styleClass="order-detail-label" text="Total Amount :" />
                                <Label fx:id="orderDetailAmount" styleClass="order-detail-value"
                                    text="\$ 1,200.00" />
                            </children>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" prefHeight="30.0" prefWidth="200.0"
                            styleClass="order-detail-box">
                            <children>
                                <FontIcon iconLiteral="fas-hashtag" iconSize="14"
                                    styleClass="detail-icon" wrappingWidth="12.67498779296875" />
                                <Label styleClass="order-detail-label" text="Total Quantity :" />
                                <Label fx:id="orderDetailQuantity" styleClass="order-detail-value"
                                    text="3" />
                            </children>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" prefHeight="30.0" prefWidth="200.0"
                            styleClass="order-detail-box">
                            <children>
                                <FontIcon iconLiteral="fas-calendar-alt" iconSize="14"
                                    styleClass="detail-icon" wrappingWidth="12.67498779296875" />
                                <Label styleClass="order-detail-label" text="Date :" />
                                <DatePicker fx:id="orderDetailDate" styleClass="order-detail-value" />
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <Separator orientation="VERTICAL" />

                <VBox prefHeight="228.0" prefWidth="447.0" spacing="15.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Region maxHeight="20.0" prefHeight="20.0" />

                        <HBox alignment="CENTER_LEFT" spacing="15.0">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="10.0"
                                    styleClass="order-detail-box" HBox.hgrow="ALWAYS">
                                    <children>
                                        <FontIcon iconColor="#64748b" iconLiteral="fas-boxes"
                                            iconSize="18" />
                                        <Label styleClass="order-detail-label"
                                            text="Return Quantity:" />
                                        <Label fx:id="totalReturnQuantityLabel"
                                            styleClass="order-detail-value" text="0" />
                                    </children>
                                </HBox>

                                <HBox alignment="CENTER_RIGHT" spacing="10.0"
                                    styleClass="order-detail-box" HBox.hgrow="ALWAYS">
                                    <children>
                                        <FontIcon iconColor="#ef4444"
                                            iconLiteral="fas-hand-holding-usd" iconSize="22" />
                                        <Label styleClass="order-detail-label" text="Total Refund:" />
                                        <Label fx:id="totalRefundLabel"
                                            styleClass="order-detail-value, refund-text-large"
                                            text="\$ 0.00" />
                                    </children>
                                </HBox>
                            </children>
                        </HBox>

                        <Region maxHeight="10.0" prefHeight="10.0" VBox.vgrow="ALWAYS" />

                        <HBox alignment="CENTER" styleClass="order-buttons-container">
                            <children>
                                <Button fx:id="exitButton" mnemonicParsing="false"
                                    styleClass="cancel-btn" text="Exit">
                                    <graphic>
                                        <FontIcon iconColor="white" iconLiteral="fas-times" />
                                    </graphic>
                                </Button>

                                <Region />
                                <Button fx:id="confirmReturnButton" mnemonicParsing="false"
                                    prefHeight="46.0" prefWidth="186.0" styleClass="confirm-btn"
                                    text="Confirm Return">
                                    <graphic>
                                        <FontIcon iconColor="white" iconLiteral="fas-check" />
                                    </graphic>
                                </Button>
                            </children>
                        </HBox>

                    </children>
                </VBox>
            </children>
        </HBox>
    </children>
</VBox>