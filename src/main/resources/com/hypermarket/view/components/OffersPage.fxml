<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane stylesheets="@../../css/MarketingDashboard.css"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.hypermarket.modules.components.OffersPageController">

    
    <VBox spacing="15" style="-fx-padding: 10;" AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
          AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
        
        
        <Label styleClass="title" text="Create New Offer" />

        
        <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 5;">
            <TextField fx:id="offerNameField" promptText="Offer name" styleClass="text-field" />
            <TextField fx:id="discountField" promptText="Discount %" styleClass="text-field" />

            <HBox fx:id="dateRange" alignment="CENTER_LEFT" spacing="10">
                <DatePicker fx:id="startDatePicker" promptText="Start Date" HBox.hgrow="ALWAYS" prefWidth="550" />
                <DatePicker fx:id="endDatePicker" promptText="End Date" HBox.hgrow="ALWAYS" prefWidth="550"/>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="20" styleClass="radio-buttons">
                <RadioButton fx:id="rbAll" text="All Products" />
                <RadioButton fx:id="rbProduct" text="Specific Product" />
                <ComboBox fx:id="productCombo" promptText="Select Product" styleClass="combo-box" />
            </HBox>

            <Button fx:id="addOfferBtn" maxWidth="Infinity" styleClass="button" text="Add Offer" />
        </VBox>

        
        <Label styleClass="title" text="Active Offers List" />

        
        <ScrollPane fx:id="offersScroll" fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
            <VBox fx:id="offersContainer" spacing="12" style="-fx-padding: 10;" />
        </ScrollPane>
        
    </VBox>
</AnchorPane>
