<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox fx:id="root" prefHeight="600.0" prefWidth="500.0" spacing="10.0"
    styleClass="pdf-viewer-root" xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    stylesheets="@../../css/PDFViewer.css"
    fx:controller="com.hypermarket.modules.components.PDFViewerController">


    <padding>
        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
    </padding>

    <children>
        <Label styleClass="header-label" text="Receipt Preview" />

        <ScrollPane fitToWidth="true" styleClass="pdf-scroll-pane" VBox.vgrow="ALWAYS">
            <content>
                <VBox fx:id="pagesContainer" alignment="TOP_CENTER" spacing="10.0"
                    styleClass="pages-container" />
            </content>
        </ScrollPane>

        <HBox alignment="CENTER_RIGHT" spacing="15.0">
            <children>
                <Button fx:id="closeButton" cancelButton="true" mnemonicParsing="false"
                    styleClass="dialog-btn, close-btn" text="Close" />

                <Button fx:id="saveButton" defaultButton="true" mnemonicParsing="false"
                    styleClass="dialog-btn, save-btn" text="Save / Print">
                    <graphic>
                        <FontIcon iconLiteral="fas-download" iconColor="white" />
                    </graphic>
                </Button>
            </children>
        </HBox>
    </children>
</VBox>