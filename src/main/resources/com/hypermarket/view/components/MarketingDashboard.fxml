<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" spacing="20" stylesheets="@../../css/MarketingDashboard.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.hypermarket.modules.components.MarketingDashboardController">
    <!-- style="-fx-padding: 20; -fx-font-family: 'Arial'; -fx-background-color: #f4fff7;" -->

    <!-- Title Centered -->
    <Label styleClass="title" text="Marketing Dashboard" VBox.vgrow="NEVER" />

    <!-- Radio Buttons for Sections -->
    <HBox alignment="CENTER" spacing="30">
        <RadioButton fx:id="reportsRadio" text="Reports" />
        <RadioButton fx:id="offersRadio" text="Offers" />
    </HBox>

    <!-- Reports Section -->
    <VBox fx:id="reportsSection" spacing="10" style="-fx-padding: 10;">
        <TextArea fx:id="inputReportArea" prefRowCount="3" promptText="Write your report..." styleClass="text-area" />
        <Button fx:id="generateReportBtn" styleClass="button" text="Add Report" />
        <ScrollPane fitToWidth="true" prefHeight="400">
            <VBox fx:id="reportsContainer" spacing="12" style="-fx-padding: 10;" />
        </ScrollPane>
    </VBox>

    <!-- Offers Section (Hidden by Default) -->
    <VBox fx:id="offersSection" managed="false" spacing="10" style="-fx-padding: 10;" visible="false">
        <TextField fx:id="offerNameField" promptText="Offer name" styleClass="text-field" />
        <TextField fx:id="discountField" promptText="Discount %" styleClass="text-field" />

        <!-- DatePickers (Start and End Dates) side by side with adjusted size -->
        <HBox fx:id="dateRange" alignment="CENTER" spacing="10">
            <DatePicker fx:id="startDatePicker" prefWidth="650" promptText="Start Date" styleClass="date-picker" />
            <DatePicker fx:id="endDatePicker" prefWidth="650" promptText="End Date" styleClass="date-picker" />
        </HBox>

        <!-- Radio Buttons for Offer Target -->
        <HBox alignment="CENTER" spacing="20">
            <RadioButton fx:id="rbAll" text="All Products" />
            <RadioButton fx:id="rbProduct" text="Specific Product" />
            <ComboBox fx:id="productCombo" promptText="Select Product" styleClass="combo-box" />
        </HBox>

        <Button fx:id="addOfferBtn" styleClass="button" text="Add Offer" />
        <ScrollPane fitToWidth="true" prefHeight="400">
            <VBox fx:id="offersContainer" spacing="12" style="-fx-padding: 10;" />
        </ScrollPane>
    </VBox>

</VBox>
